# Supabase (preferred — overrides hardcoded fallbacks in supabaseClient.ts)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# OpenRouter — prefer server-only key for the /api/ai Vite proxy
OPENROUTER_API_KEY="your-openrouter-key"
# Fallback only (exposed to browser if proxy unavailable):
VITE_OPENROUTER_API_KEY=""
VITE_OPENROUTER_MODEL="openai/gpt-4o-mini"
VITE_OPENROUTER_SITE_URL="http://localhost:3000"
VITE_OPENROUTER_APP_NAME="PreVisio"

# Legacy AI Studio (unused by current helpers)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
