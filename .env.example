# Supabase (required)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# OpenRouter — server-only. Never use VITE_ for the API key.
OPENROUTER_API_KEY="your-openrouter-key"
VITE_OPENROUTER_MODEL="openai/gpt-4o-mini"
VITE_OPENROUTER_SITE_URL="http://localhost:3000"
VITE_OPENROUTER_APP_NAME="PreVisio"

# Netlify functions (invite-staff, public-order, billing) — never ship to the browser
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Stripe Billing (server-only secrets)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO="price_..."
APP_URL="http://localhost:3000"
